{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/g.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "datos/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/datos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ]
}
